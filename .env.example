# Phase 1 Kalshi authentication settings.
# Copy this file to .env locally and replace placeholders with demo credentials.

KALSHI_ENV=demo
KALSHI_API_KEY_ID=your-demo-api-key-id

# Provide either KALSHI_PRIVATE_KEY_PATH or KALSHI_PRIVATE_KEY_PEM.
KALSHI_PRIVATE_KEY_PATH=path/to/your/demo-private-key.key
# KALSHI_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional settings.
# KALSHI_PRIVATE_KEY_PASSPHRASE=
# KALSHI_REQUEST_TIMEOUT_SECONDS=10
# KALSHI_API_BASE_URL=https://demo-api.kalshi.co/trade-api/v2

