# Linux VPS production example.
# Copy to .env on the VPS and fill in real values manually.
# Do not commit real credentials or private key material.

KALSHI_ENV=prod
KALSHI_API_KEY_ID=your-prod-api-key-id

# Provide either a key path or PEM content.
KALSHI_PRIVATE_KEY_PATH=/opt/kalshi-bot/keys/kalshi-prod-key.pem
# KALSHI_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# KALSHI_PRIVATE_KEY_PASSPHRASE=

KALSHI_REQUEST_TIMEOUT_SECONDS=10

# Kalshi market data validation inputs.
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2
# Manual WebSocket tickers remain available for standalone validation scripts.
# The continuous runner discovers active BTC/ETH/SOL/XRP/DOGE/BNB/HYPE crypto markets automatically.
KALSHI_WS_MARKET_TICKERS=KXEXAMPLE-PROD-TICKER
KALSHI_WS_MESSAGE_LIMIT=25
KALSHI_WS_RECEIVE_TIMEOUT_SECONDS=30
KALSHI_WS_MAX_RECONNECT_ATTEMPTS=3
KALSHI_WS_RECONNECT_INITIAL_DELAY_SECONDS=1
KALSHI_WS_RECONNECT_MAX_DELAY_SECONDS=30

# Runner-managed Kalshi crypto market discovery.
KALSHI_AUTO_MARKET_DISCOVERY_ENABLED=true
KALSHI_CRYPTO_MARKET_SERIES_JSON={"BTC-USD":["KXBTC15M","KXBTC30M"],"ETH-USD":["KXETH15M","KXETH30M"],"SOL-USD":["KXSOL15M"],"XRP-USD":["KXXRP15M"],"DOGE-USD":["KXDOGE15M"],"BNB-USD":["KXBNB15M"],"HYPE-USD":["KXHYPE15M"]}
KALSHI_MARKET_DISCOVERY_REFRESH_CYCLES=12

# External crypto feed.
CRYPTO_FEED_WS_URL=wss://advanced-trade-ws.coinbase.com
CRYPTO_FEED_PRODUCTS=BTC-USD,ETH-USD,SOL-USD,XRP-USD,DOGE-USD,BNB-USD,HYPE-USD
CRYPTO_FEED_MESSAGE_LIMIT=25
CRYPTO_FEED_RECEIVE_TIMEOUT_SECONDS=30
CRYPTO_FEED_MAX_RECONNECT_ATTEMPTS=3
CRYPTO_FEED_RECONNECT_INITIAL_DELAY_SECONDS=1
CRYPTO_FEED_RECONNECT_MAX_DELAY_SECONDS=30

# Observability.
LOG_DIRECTORY=logs
LOG_JSONL_ENABLED=true
REPLAY_DIRECTORY=replay
REPLAY_WRITE_ENABLED=true
TIME_SYNC_MAX_DRIFT_MS=1500
TIME_SYNC_LOG_RESULTS=true
LATENCY_DIAGNOSTICS_ENABLED=false
LATENCY_DIAGNOSTICS_SAMPLE_INTERVAL_MS=1000
LATENCY_DIAGNOSTICS_MIN_SPOT_MOVE_BPS=5
LATENCY_DIAGNOSTICS_MAX_DEPTH_LEVELS=3

# Bias engine.
BIAS_PRODUCTS=BTC-USD,ETH-USD,SOL-USD,XRP-USD,DOGE-USD,BNB-USD,HYPE-USD
BIAS_LOOKBACK_SECONDS=1800
BIAS_RECENT_WINDOW_SECONDS=60
BIAS_MIN_SAMPLES=20
BIAS_STALE_DATA_SECONDS=15
BIAS_CHOP_THRESHOLD_BPS=10
BIAS_IMPULSE_MIN_ABS_BPS=15

# Contract scanner mapping.
# Manual fallback only when KALSHI_AUTO_MARKET_DISCOVERY_ENABLED=false.
CONTRACT_SCANNER_PRODUCT_MARKETS_JSON={"BTC-USD":["KXBTCD-EXAMPLE-1"],"ETH-USD":["KXETHD-EXAMPLE-1"]}

# Simulation defaults.
SIMULATION_ENABLED=true
SIMULATION_MAX_NEW_POSITIONS_PER_EVALUATION=1
SIMULATION_POSITION_ID_PREFIX=sim
SIMULATION_EXIT_ENABLED=true
SIMULATION_ALLOW_SAME_PASS_REENTRY=false

# Risk model defaults.
RISK_ACCOUNT_BALANCE_DOLLARS=10
RISK_MIN_PERCENT_PER_TRADE=0.01
RISK_MAX_PERCENT_PER_TRADE=0.03
RISK_MIN_STAKE_DOLLARS=0.10
RISK_MAX_STAKE_DOLLARS=3
RISK_MAX_OPEN_POSITIONS=2
RISK_MAX_TOTAL_EXPOSURE_DOLLARS=10
RISK_DAILY_LOSS_LIMIT_DOLLARS=5
RISK_KILL_SWITCH_ACTIVE=false

# Explicit live validation target.
LIVE_VALIDATION_ENABLED=false
LIVE_VALIDATION_ENV=prod
LIVE_VALIDATION_TICKER=KXBTCD-EXAMPLE-1
LIVE_VALIDATION_ACTION=buy
LIVE_VALIDATION_SIDE=yes
LIVE_VALIDATION_COUNT=1
LIVE_VALIDATION_PRICE_DOLLARS=0.0100
LIVE_VALIDATION_TIME_IN_FORCE=immediate_or_cancel
LIVE_VALIDATION_POLL_ATTEMPTS=5
LIVE_VALIDATION_POLL_INTERVAL_SECONDS=1
LIVE_VALIDATION_CLIENT_ORDER_ID_PREFIX=live-smoke

# Phase 10 live guardrails.
LIVE_TRADING_ENABLED=false
LIVE_KILL_SWITCH_ACTIVE=false
LIVE_RUNNER_EXECUTION_ENABLED=false
LIVE_MAX_EXPOSURE_DOLLARS=10
LIVE_MIN_STAKE_DOLLARS=0.10
LIVE_MAX_STAKE_DOLLARS=3
LIVE_MAX_OPEN_POSITIONS=2
LIVE_MAX_CONTRACT_COUNT=1000
LIVE_PROFIT_CAPTURE_ENABLED=false
LIVE_PROFIT_CAPTURE_PRICE=0.99
LIVE_TRAILING_STOP_ENABLED=false
LIVE_TRAILING_STOP_DISTANCE=0.05
LIVE_ENTRY_END_WINDOW_ONLY=false
LIVE_ENTRY_END_WINDOW_MINUTES=5
LIVE_ENTRY_MIN_REMAINING_SECONDS=180
LIVE_ENTRY_SEGMENT_PACING_ENABLED=false
LIVE_ENTRY_SEGMENT_MAX_10_TO_5=1
LIVE_ENTRY_SEGMENT_MAX_5_TO_3=1
LIVE_ENTRY_SEGMENT_MAX_3_TO_1=1
LIVE_ENTRY_SEGMENT_MAX_FINAL_1=1
LIVE_FAST_SCAN_ENABLED=false
LIVE_FAST_SCAN_INTERVAL_SECONDS=2
LIVE_FAST_SCAN_COOLDOWN_SECONDS=5
LIVE_REVERSAL_CROSS_HOLD_ENABLED=true
LIVE_REVERSAL_CROSS_HOLD_SECONDS=90
LIVE_MID_PRICE_TIGHTENING_ENABLED=true
LIVE_MID_PRICE_MIN=0.50
LIVE_MID_PRICE_MAX=0.70
LIVE_MAX_OPEN_POSITIONS_PER_PRODUCT=2
LIVE_MAX_ENTRIES_PER_PRODUCT_PER_SESSION=2
LIVE_COMPOSITE_QUALITY_FILTER_ENABLED=true
LIVE_COMPOSITE_MAX_ENTRY_PRICE=0.50
LIVE_COMPOSITE_LOW_PRICE_MAX=0.30
LIVE_COMPOSITE_ALLOWED_SEGMENTS=10_to_5,5_to_3
LIVE_COMPOSITE_REQUIRE_TREND=true
LIVE_COMPOSITE_REQUIRE_ITM=true
LIVE_COMPOSITE_BLOCK_NEEDS_CROSS=true
LIVE_REVERSAL_MAX_ENTRY_PRICE=0.10
LIVE_BLOCK_NEEDS_CROSS=true
LIVE_MAX_REQUIRED_BPS_PER_MINUTE=0.25
LIVE_OUTSIDE_END_WINDOW_EXCEPTION_ENABLED=false
LIVE_OUTSIDE_END_WINDOW_MAX_PRICE=0.30
LIVE_EV_FILTER_ENABLED=true
LIVE_MIN_EXPECTED_VALUE=0.00
LIVE_EV_PRICE_MAX_ITM_NO_CROSS=0.50
LIVE_EV_PRICE_MAX_ITM_NO_CROSS_BTC=
LIVE_EV_PRICE_MAX_ITM_NO_CROSS_DOGE=
LIVE_EV_PRICE_MAX_ITM_NO_CROSS_ETH=
LIVE_EV_PRICE_MAX_ITM_NO_CROSS_SOL=
LIVE_EV_PRICE_MAX_ITM_NO_CROSS_XRP=
LIVE_EV_PRICE_MAX_ITM_NO_CROSS_HYPE=
LIVE_EV_PRICE_MAX_ITM_NO_CROSS_BNB=
LIVE_EV_PRICE_MAX_NEEDS_CROSS=0.30
LIVE_EV_REQUIRED_BPS_MAX=0.25
LIVE_EV_ALLOWED_SEGMENTS=10_to_5,5_to_3
LIVE_EV_CONSERVATIVE_ALLOWED_SEGMENTS=10_to_5,5_to_3,3_to_1
LIVE_EV_ALLOW_REVERSAL=false
LIVE_EV_CANDIDATE_A_WIN_PROBABILITY=0.87
LIVE_EV_CANDIDATE_B_WIN_PROBABILITY=0.92
LIVE_PRODUCT_BLOCKLIST=ETH-USD,XRP-USD
LIVE_CONDITIONAL_HIGH_PRICE_PASS_ENABLED=true
LIVE_CONDITIONAL_MAX_PREMIUM_OVER_MIDPOINT=0.08
LIVE_CONDITIONAL_MAX_SPREAD=0.15
LIVE_CONDITIONAL_MAX_SCANNER_PREMIUM=0.12
LIVE_CONDITIONAL_ALLOW_EXTREME_ASYMMETRY=false
LIVE_CONDITIONAL_ALLOW_HIGH_PRICE_CEILING_BYPASS=false
LIVE_CONDITIONAL_HIGH_PRICE_CEILING_MAX=0.70
LIVE_EV_TIMING_BYPASS_ENABLED=true
LIVE_EV_EXTRA_ENTRIES_PER_PRODUCT_PER_SESSION=0
LIVE_EV_EXTRA_OPEN_POSITIONS_PER_PRODUCT=0
LIVE_QUIET_CONTINUATION_ENABLED=false
LIVE_QUIET_CONTINUATION_MAX_RECENT_BPS=6
LIVE_QUIET_CONTINUATION_MAX_3M_ABS_BPS=12
LIVE_QUIET_CONTINUATION_MAX_5M_ABS_BPS=20
LIVE_QUIET_CONTINUATION_MAX_5M_RANGE_BPS=25
LIVE_QUIET_CONTINUATION_BLOCK_DECELERATION=true
LIVE_QUIET_CONTINUATION_BLOCK_NEAR_EXTREME=true
LIVE_QUIET_CONTINUATION_MIN_DISTANCE_FROM_EXTREME_BPS=5
LIVE_EXHAUSTION_GUARD_ENABLED=true
LIVE_EXHAUSTION_BURST_3M_BPS=20
LIVE_EXHAUSTION_BURST_5M_BPS=30
LIVE_EXHAUSTION_NEAR_EXTREME_BPS=3
LIVE_EXHAUSTION_DECELERATION_RECENT_BPS=8
LIVE_EXHAUSTION_STRICT_PRODUCTS=HYPE-USD,ETH-USD,XRP-USD
LIVE_EXHAUSTION_STRICT_BURST_3M_BPS=15
LIVE_EXHAUSTION_PROGRESSION_OVERRIDE_ENABLED=false
LIVE_EXHAUSTION_PROGRESSION_MIN_ALIGNED_CYCLES=2
LIVE_EARLY_MOMENTUM_ENABLED=true
LIVE_EARLY_MOMENTUM_MIN_RECENT_BPS=15
LIVE_EARLY_MOMENTUM_MAX_3M_BURST_BPS=20
LIVE_EARLY_MOMENTUM_MAX_ENTRY_PRICE=0.50
LIVE_EV_MAX_ACTUAL_COST=0.70
LIVE_EV_MIN_REWARD_DOLLARS=0.30
LIVE_EV_REQUIRE_POSITIVE_COST_EXPECTED_VALUE=true
LIVE_EV_EXHAUSTION_BLOCK_ENABLED=true
LIVE_CANDIDATE_FUNNEL_DIAGNOSTICS_ENABLED=false
LIVE_WEAK_MOMENTUM_STABILIZATION_MIN_DISTANCE=
LIVE_WEAK_MOMENTUM_MAX_RANGE=
LIVE_WEAK_MOMENTUM_MAX_PRICE=
LIVE_MINI_EXHAUSTION_ENABLED=false
LIVE_MINI_EXHAUSTION_3M_BPS=12
LIVE_MINI_EXHAUSTION_RANGE_BPS=25
LIVE_MINI_EXHAUSTION_RECENT_BPS=6
LIVE_BIAS_RECENT_RETURN_MIN=
LIVE_BIAS_LOOKBACK_RETURN_MIN=
LIVE_MIN_CROSS_DISTANCE_BPS=0
