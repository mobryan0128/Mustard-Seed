# Linux VPS production example.
# Copy to .env on the VPS and fill in real values manually.
# Do not commit real credentials or private key material.

KALSHI_ENV=prod
KALSHI_API_KEY_ID=your-prod-api-key-id

# Provide either a key path or PEM content.
KALSHI_PRIVATE_KEY_PATH=/opt/kalshi-bot/keys/kalshi-prod-key.pem
# KALSHI_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# KALSHI_PRIVATE_KEY_PASSPHRASE=

KALSHI_REQUEST_TIMEOUT_SECONDS=10

# Kalshi market data validation inputs.
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2
# Manual WebSocket tickers remain available for standalone validation scripts.
# The continuous runner discovers active BTC/ETH crypto markets automatically.
KALSHI_WS_MARKET_TICKERS=KXEXAMPLE-PROD-TICKER
KALSHI_WS_MESSAGE_LIMIT=25
KALSHI_WS_RECEIVE_TIMEOUT_SECONDS=30
KALSHI_WS_MAX_RECONNECT_ATTEMPTS=3
KALSHI_WS_RECONNECT_INITIAL_DELAY_SECONDS=1
KALSHI_WS_RECONNECT_MAX_DELAY_SECONDS=30

# Runner-managed Kalshi crypto market discovery.
KALSHI_AUTO_MARKET_DISCOVERY_ENABLED=true
KALSHI_CRYPTO_MARKET_SERIES_JSON={"BTC-USD":["KXBTC15M","KXBTC30M"],"ETH-USD":["KXETH15M","KXETH30M"],"SOL-USD":["KXSOL15M"],"XRP-USD":["KXXRP15M"]}
KALSHI_MARKET_DISCOVERY_REFRESH_CYCLES=12

# External crypto feed.
CRYPTO_FEED_WS_URL=wss://advanced-trade-ws.coinbase.com
CRYPTO_FEED_PRODUCTS=BTC-USD,ETH-USD,SOL-USD,XRP-USD
CRYPTO_FEED_MESSAGE_LIMIT=25
CRYPTO_FEED_RECEIVE_TIMEOUT_SECONDS=30
CRYPTO_FEED_MAX_RECONNECT_ATTEMPTS=3
CRYPTO_FEED_RECONNECT_INITIAL_DELAY_SECONDS=1
CRYPTO_FEED_RECONNECT_MAX_DELAY_SECONDS=30

# Observability.
LOG_DIRECTORY=logs
LOG_JSONL_ENABLED=true
REPLAY_DIRECTORY=replay
REPLAY_WRITE_ENABLED=true
TIME_SYNC_MAX_DRIFT_MS=1500
TIME_SYNC_LOG_RESULTS=true

# Bias engine.
BIAS_PRODUCTS=BTC-USD,ETH-USD,SOL-USD,XRP-USD
BIAS_LOOKBACK_SECONDS=1800
BIAS_RECENT_WINDOW_SECONDS=60
BIAS_MIN_SAMPLES=20
BIAS_STALE_DATA_SECONDS=15
BIAS_CHOP_THRESHOLD_BPS=10

# Contract scanner mapping.
# Manual fallback only when KALSHI_AUTO_MARKET_DISCOVERY_ENABLED=false.
CONTRACT_SCANNER_PRODUCT_MARKETS_JSON={"BTC-USD":["KXBTCD-EXAMPLE-1"],"ETH-USD":["KXETHD-EXAMPLE-1"]}

# Simulation defaults.
SIMULATION_ENABLED=true
SIMULATION_MAX_NEW_POSITIONS_PER_EVALUATION=1
SIMULATION_POSITION_ID_PREFIX=sim
SIMULATION_EXIT_ENABLED=true
SIMULATION_ALLOW_SAME_PASS_REENTRY=false

# Risk model defaults.
RISK_ACCOUNT_BALANCE_DOLLARS=10
RISK_MIN_PERCENT_PER_TRADE=0.01
RISK_MAX_PERCENT_PER_TRADE=0.03
RISK_MIN_STAKE_DOLLARS=0.10
RISK_MAX_STAKE_DOLLARS=3
RISK_MAX_OPEN_POSITIONS=2
RISK_MAX_TOTAL_EXPOSURE_DOLLARS=10
RISK_DAILY_LOSS_LIMIT_DOLLARS=5
RISK_KILL_SWITCH_ACTIVE=false

# Explicit live validation target.
LIVE_VALIDATION_ENABLED=false
LIVE_VALIDATION_ENV=prod
LIVE_VALIDATION_TICKER=KXBTCD-EXAMPLE-1
LIVE_VALIDATION_ACTION=buy
LIVE_VALIDATION_SIDE=yes
LIVE_VALIDATION_COUNT=1
LIVE_VALIDATION_PRICE_DOLLARS=0.0100
LIVE_VALIDATION_TIME_IN_FORCE=immediate_or_cancel
LIVE_VALIDATION_POLL_ATTEMPTS=5
LIVE_VALIDATION_POLL_INTERVAL_SECONDS=1
LIVE_VALIDATION_CLIENT_ORDER_ID_PREFIX=live-smoke

# Phase 10 live guardrails.
LIVE_TRADING_ENABLED=false
LIVE_KILL_SWITCH_ACTIVE=false
LIVE_RUNNER_EXECUTION_ENABLED=false
LIVE_MAX_ORDER_COUNT=1
LIVE_MAX_OPEN_POSITIONS=1
LIVE_MIN_ENTRY_PRICE_DOLLARS=0
LIVE_MAX_ENTRY_PRICE_DOLLARS=0.800
LIVE_MAX_EXECUTION_SPREAD_DOLLARS=0.100
