# Template only.
# This unit runs the simulation-first orchestrator.
# It does not enable autonomous live trading.

[Unit]
Description=Kalshi Bot Simulation Runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kalshi
Group=kalshi
WorkingDirectory=/opt/kalshi-bot
EnvironmentFile=/opt/kalshi-bot/.env

ExecStart=/opt/kalshi-bot/.venv/bin/python /opt/kalshi-bot/scripts/run_kalshi_bot.py --env-file /opt/kalshi-bot/.env

Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
